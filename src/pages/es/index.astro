---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import { es } from '../../i18n/es';

const locale = 'es';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Gym & Fitboxing de Alto Nivel en Katowice | Baldurion"
  description="Entrenador personal y fitboxing en Katowice y online. Método estructurado de 12 semanas adaptado a tu nivel, con seguimiento técnico. Reserva una llamada gratuita."
  locale={locale}
>
  <HomeHero t={es.home.hero} base={base} locale={locale} />
</BaseLayout>
