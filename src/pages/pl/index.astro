---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import { pl } from '../../i18n/pl';

const locale = 'pl';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Baldurion — Fitness oparty na nauce"
  description="Spersonalizowany trening z naukowym rygorem. Prawdziwa siła, prawdziwa moc. Trener personalny w Katowicach."
  locale={locale}
>
  <HomeHero t={pl.home.hero} base={base} locale={locale} />
</BaseLayout>
