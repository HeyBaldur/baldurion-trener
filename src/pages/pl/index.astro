---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomeHero from '../../components/HomeHero.astro';
import { pl } from '../../i18n/pl';

const locale = 'pl';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<BaseLayout
  title="Gym & Fitboxing na Najwyższym Poziomie w Katowicach | Baldurion"
  description="Trener personalny i fitboxing w Katowicach oraz online. Ustrukturyzowana 12-tygodniowa metoda dopasowana do Twojego poziomu. Umów bezpłatną rozmowę."
  locale={locale}
>
  <HomeHero t={pl.home.hero} base={base} locale={locale} />
</BaseLayout>
