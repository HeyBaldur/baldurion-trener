---
interface Props {
  t: {
    eyebrow: string;
    titleLine1: string;
    titleLine2: string;
    subtitle: string;
    ctaPrimary: string;
    ctaSecondary: string;
    badgeTop: string;
    badgeBottom: string;
    stat2Value: string;
    stat2Label: string;
    stat3Value: string;
    stat3Label: string;
  };
  base: string;
  locale: string;
}

const { t, base, locale } = Astro.props;
const calendlyUrl = "https://calendly.com/smart-gym-app-assistance/30min";
const lp = locale === "en" ? base : `${base}${locale}/`;
const heroImg = `${base}images/brand/banner-2.png`;
---

<section
  class="relative min-h-[calc(100vh-4rem)] bg-dark flex items-stretch overflow-hidden"
>
  <!-- Photo side -->
  <div class="absolute inset-0 lg:left-[55%]">
    <img
      src={heroImg}
      alt="Rodolfo Calvo Jaubert entrenando"
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
      width="900"
      height="1200"
    />
    <!-- gradient blending left edge into dark bg on desktop -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-dark via-dark/60 to-dark/10 lg:via-dark/40 lg:to-transparent"
    >
    </div>
    <!-- gradient blending bottom on mobile -->
    <div
      class="absolute inset-0 bg-gradient-to-t from-dark via-dark/50 to-transparent lg:hidden"
    >
    </div>
    <!-- photo bottom fade into dark section below -->
    <div
      class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-b from-transparent to-dark pointer-events-none"
    >
    </div>
  </div>

  <!-- Content -->
  <div
    class="relative z-10 w-full max-w-[1280px] mx-auto px-6 py-12 lg:px-12 lg:py-0 flex flex-col justify-center lg:max-w-[55%] lg:mx-0 lg:ml-[max(3rem,calc((100vw-1280px)/2+3rem))]"
  >
    <!-- Eyebrow -->
    <p class="text-lime text-[11px] font-bold tracking-[0.3em] uppercase mb-6">
      {t.eyebrow}
    </p>

    <!-- Headline -->
    <h1
      class="hero-title font-bold text-[clamp(2.75rem,6.5vw,5.25rem)] leading-[0.98] tracking-[-0.02em] mb-6"
    >
      <span class="hero-title-main">{t.titleLine1}</span><br /><span class="hero-title-accent">{t.titleLine2}</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-light/70 text-[17px] leading-[1.65] max-w-[480px] mb-10">
      {t.subtitle}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-3 mb-8">
      <a
        href={calendlyUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-lime text-dark font-bold text-[14px] tracking-[0.03em] uppercase px-7 py-4 rounded-full no-underline transition-transform duration-200 hover:-translate-y-0.5"
      >
        {t.ctaPrimary}
      </a>
      <a
        href={`${lp}coaching/#metodo`}
        class="inline-flex items-center gap-2 text-light/80 font-semibold text-[14px] no-underline border border-light/20 px-7 py-4 rounded-full transition-colors duration-200 hover:border-lime/60 hover:text-lime"
      >
        {t.ctaSecondary}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Social links -->
    <div class="flex items-center gap-4 mb-10">
      <a href="https://www.instagram.com/baldurion_fitness/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex text-light/40 transition-colors duration-200 hover:text-lime">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
        </svg>
      </a>
      <a href="https://www.youtube.com/@BaldurionFitness" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="flex text-light/40 transition-colors duration-200 hover:text-lime">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
          <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
        </svg>
      </a>
      <a href="https://x.com/TheBaldurion" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="flex text-light/40 transition-colors duration-200 hover:text-lime">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
      </a>
    </div>

    <!-- Stats -->
    <div class="flex flex-wrap gap-x-6 gap-y-3">
      {
        [
          { value: t.stat2Value, label: t.stat2Label },
          { value: t.stat3Value, label: t.stat3Label },
        ].map((stat, i) => (
          <div class="flex items-center gap-3">
            {i > 0 && (
              <span class="text-light/20 hidden sm:block" aria-hidden="true">
                |
              </span>
            )}
            <div>
              <div class="text-light font-bold text-[15px] leading-none">
                {stat.value}
              </div>
              <div class="text-light/50 text-[11px] mt-1">{stat.label}</div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Metallic gradient on the headline. Kept in CSS (not utilities) so the
     @supports fallback can guarantee the text is never invisible. */
  .hero-title-main,
  .hero-title-accent {
    color: var(--color-light);
  }

  @supports ((-webkit-background-clip: text) or (background-clip: text)) {
    .hero-title-main,
    .hero-title-accent {
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      /* keeps the descenders from being clipped by the gradient box */
      padding-bottom: 0.06em;
    }

    .hero-title-main {
      background-image: linear-gradient(
        170deg,
        #ffffff 0%,
        #f2f2ee 38%,
        #b9bcb2 78%,
        #8f9389 100%
      );
    }

    .hero-title-accent {
      background-image: linear-gradient(
        170deg,
        #eaf7a2 0%,
        #d4e84a 48%,
        #a9c22b 100%
      );
    }
  }
</style>
