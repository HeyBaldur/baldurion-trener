---
import Logo from './Logo.astro';
import type { Locale } from '../i18n/index';
import { useTranslations, routeSlugs } from '../i18n/index';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lp = locale === 'en' ? base : `${base}${locale}/`;

const legalPaths = {
  privacy: routeSlugs.privacy[locale],
  cookies: routeSlugs.cookies[locale],
  legal: routeSlugs.legal[locale],
  terms: routeSlugs.terms[locale],
  preferences: routeSlugs.preferences[locale],
};
---

<footer class="mt-[96px] border-t border-[rgba(0,0,0,0.06)] dark:border-[rgba(255,255,255,0.06)] max-[640px]:mt-[64px]">
  <div class="max-w-[1280px] mx-auto px-[32px] pt-[64px] pb-[32px] max-[640px]:px-[20px] max-[640px]:pt-[48px] max-[640px]:pb-[24px]">

    <div class="grid grid-cols-[1.2fr_1fr_1fr_1.4fr] gap-[48px] items-start mb-[48px] max-[1024px]:grid-cols-2 max-[1024px]:gap-[40px] max-[640px]:grid-cols-1 max-[640px]:gap-[32px] max-[640px]:mb-[32px]">

      <!-- Brand column -->
      <div class="flex flex-col">
        <a href={lp} aria-label="Baldurion — inicio">
          <Logo locale={locale} size="s" />
        </a>
        <p class="text-[13px] leading-[1.5] mt-[14px] max-w-[220px] text-[rgba(0,0,0,0.45)] dark:text-[rgba(255,255,255,0.4)]">
          {t.footer.tagline}
        </p>
      </div>

      <!-- Nav column -->
      <div class="flex flex-col">
        <p class="text-[11px] font-bold tracking-[0.25em] uppercase m-0 mb-[20px] text-[rgba(0,0,0,0.35)] dark:text-[rgba(255,255,255,0.3)]">
          {t.footer.navTitle}
        </p>
        <nav class="flex flex-col gap-[12px]">
          <a href={lp} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.nav.home}</a>
          <a href={`${lp}${routeSlugs.coaching[locale]}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.nav.coaching}</a>
          <a href={`${lp}${routeSlugs.about[locale]}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.nav.about}</a>
          <a href={`${lp}${routeSlugs.researches[locale]}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.nav.researches}</a>
          <a href={`${lp}${routeSlugs.contact[locale]}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.nav.contact}</a>
        </nav>
      </div>

      <!-- Legal column -->
      <div class="flex flex-col">
        <p class="text-[11px] font-bold tracking-[0.25em] uppercase m-0 mb-[20px] text-[rgba(0,0,0,0.35)] dark:text-[rgba(255,255,255,0.3)]">
          {t.footer.legalTitle}
        </p>
        <nav class="flex flex-col gap-[12px]">
          <a href={`${lp}${legalPaths.privacy}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.footer.privacy}</a>
          <a href={`${lp}${legalPaths.cookies}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.footer.cookies}</a>
          <a href={`${lp}${legalPaths.legal}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.footer.legalNotice}</a>
          <a href={`${lp}${legalPaths.terms}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.footer.terms}</a>
          <a href={`${lp}${legalPaths.preferences}/`} class="text-[14px] font-semibold no-underline transition-colors duration-200 text-[rgba(0,0,0,0.6)] dark:text-[rgba(255,255,255,0.6)] hover:text-dark dark:hover:text-lime">{t.footer.preferences}</a>
        </nav>
      </div>

      <!-- Institutional column -->
      <div class="flex flex-col gap-[20px] max-[1024px]:col-span-full max-[1024px]:flex-row max-[1024px]:flex-wrap max-[1024px]:gap-[32px] max-[1024px]:items-center max-[1024px]:pt-[32px] max-[1024px]:border-t max-[1024px]:border-[rgba(0,0,0,0.06)] dark:max-[1024px]:border-[rgba(255,255,255,0.06)] max-[640px]:flex-col max-[640px]:items-start max-[640px]:pt-0 max-[640px]:border-t-0">

        <div class="flex items-start gap-[12px]">
          <svg viewBox="0 0 810 540" width="64" height="42" role="img" aria-label={t.footer.euTitle} class="rounded-[4px] shrink-0 shadow-[0_4px_12px_rgba(0,0,0,0.35)] border border-[rgba(0,0,0,0.08)] dark:border-[rgba(255,255,255,0.06)]">
            <rect width="810" height="540" fill="#003399"></rect>
            <polygon points="405,60 412.05,80.29 433.53,80.73 416.41,93.71 422.63,114.27 405,102 387.37,114.27 393.59,93.71 376.47,80.73 397.95,80.29" fill="#FFCC00"></polygon>
            <polygon points="495,84.12 502.05,104.41 523.53,104.85 506.41,117.83 512.63,138.39 495,126.12 477.37,138.39 483.59,117.83 466.47,104.85 487.95,104.41" fill="#FFCC00"></polygon>
            <polygon points="560.88,150 567.93,170.29 589.41,170.73 572.29,183.71 578.51,204.27 560.88,192 543.25,204.27 549.47,183.71 532.35,170.73 553.83,170.29" fill="#FFCC00"></polygon>
            <polygon points="585,240 592.05,260.29 613.53,260.73 596.41,273.71 602.63,294.27 585,282 567.37,294.27 573.59,273.71 556.47,260.73 577.95,260.29" fill="#FFCC00"></polygon>
            <polygon points="560.88,330 567.93,350.29 589.41,350.73 572.29,363.71 578.51,384.27 560.88,372 543.25,384.27 549.47,363.71 532.35,350.73 553.83,350.29" fill="#FFCC00"></polygon>
            <polygon points="495,395.88 502.05,416.17 523.53,416.61 506.41,429.59 512.63,450.15 495,437.88 477.37,450.15 483.59,429.59 466.47,416.61 487.95,416.17" fill="#FFCC00"></polygon>
            <polygon points="405,420 412.05,440.29 433.53,440.73 416.41,453.71 422.63,474.27 405,462 387.37,474.27 393.59,453.71 376.47,440.73 397.95,440.29" fill="#FFCC00"></polygon>
            <polygon points="315,395.88 322.05,416.17 343.53,416.61 326.41,429.59 332.63,450.15 315,437.88 297.37,450.15 303.59,429.59 286.47,416.61 307.95,416.17" fill="#FFCC00"></polygon>
            <polygon points="249.12,330 256.17,350.29 277.65,350.73 260.53,363.71 266.75,384.27 249.12,372 231.49,384.27 237.71,183.71 220.59,350.73 242.07,350.29" fill="#FFCC00"></polygon>
            <polygon points="225,240 232.05,260.29 253.53,260.73 236.41,273.71 242.63,294.27 225,282 207.37,294.27 213.59,273.71 196.47,260.73 217.95,260.29" fill="#FFCC00"></polygon>
            <polygon points="249.12,150 256.17,170.29 277.65,170.73 260.53,183.71 266.75,204.27 249.12,192 231.49,204.27 237.71,183.71 220.59,170.73 242.07,170.29" fill="#FFCC00"></polygon>
            <polygon points="315,84.12 322.05,104.41 343.53,104.85 326.41,117.83 332.63,138.39 315,126.12 297.37,138.39 303.59,117.83 286.47,104.85 307.95,104.41" fill="#FFCC00"></polygon>
          </svg>
          <div class="flex flex-col">
            <p class="text-[13px] font-bold leading-[1.3] m-0 mb-[3px] text-[rgba(0,0,0,0.8)] dark:text-[rgba(255,255,255,0.8)]">{t.footer.euTitle}</p>
            <p class="text-[11px] leading-[1.4] m-0 mb-[8px] text-[rgba(0,0,0,0.45)] dark:text-[rgba(255,255,255,0.4)]">{t.footer.euSubtitle}</p>
          </div>
        </div>

        <a
          href="https://discord.gg/hXfKghXa6U"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-[12px] no-underline rounded-[10px] px-[14px] py-[12px] max-w-[280px] w-full border border-[rgba(0,0,0,0.08)] dark:border-[rgba(255,255,255,0.08)] bg-[rgba(88,101,242,0.04)] dark:bg-[rgba(88,101,242,0.08)] transition-colors duration-200 hover:border-[rgba(88,101,242,0.45)] hover:bg-[rgba(88,101,242,0.1)] max-[1024px]:max-w-none max-[1024px]:w-auto"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="#5865F2" aria-hidden="true" class="shrink-0">
            <path d="M20.317 4.369a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.211.375-.445.864-.608 1.249a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.036A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.1 13.1 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127c-.598.35-1.22.645-1.873.891a.076.076 0 0 0-.041.107c.36.699.772 1.364 1.225 1.993a.076.076 0 0 0 .084.029 19.84 19.84 0 0 0 6.002-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.029zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.211 0 2.176 1.095 2.157 2.42 0 1.333-.955 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.211 0 2.176 1.095 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <div class="flex flex-col">
            <p class="text-[13px] font-bold leading-[1.3] m-0 mb-[3px] text-[rgba(0,0,0,0.8)] dark:text-[rgba(255,255,255,0.85)]">{t.footer.discordTitle}</p>
            <p class="text-[11px] leading-[1.4] m-0 text-[rgba(0,0,0,0.45)] dark:text-[rgba(255,255,255,0.4)]">{t.footer.discordSubtitle}</p>
            <span class="text-[11px] font-bold tracking-[0.08em] uppercase mt-[6px] text-[#5865F2] dark:text-[#8b95f7]">
              {t.footer.discordCta} <span class="inline-block transition-transform duration-200 group-hover:translate-x-[3px]">&rarr;</span>
            </span>
          </div>
        </a>

      </div>
    </div>

    <div class="text-center text-[11px] font-bold tracking-[0.3em] uppercase py-[28px] mb-[24px] text-[rgba(0,0,0,0.3)] dark:text-[rgba(255,255,255,0.25)] border-t border-b border-[rgba(0,0,0,0.06)] dark:border-[rgba(255,255,255,0.06)]">
      {t.footer.taglineCentral}
    </div>

    <div class="flex justify-between items-center flex-wrap gap-[16px] max-[640px]:flex-col max-[640px]:items-start">
      <p class="text-[12px] m-0 text-[rgba(0,0,0,0.35)] dark:text-[rgba(255,255,255,0.3)]">
        &copy; {year} Baldurion &middot; {t.footer.rights}
      </p>
      <div class="flex items-center gap-[16px]">
        <a href="https://www.instagram.com/baldurion_fitness/" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="flex transition-colors duration-200 text-[rgba(0,0,0,0.4)] dark:text-[rgba(255,255,255,0.35)] hover:text-dark dark:hover:text-[rgba(255,255,255,0.9)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
          </svg>
        </a>
        <a href="https://www.youtube.com/@BaldurionFitness" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="flex transition-colors duration-200 text-[rgba(0,0,0,0.4)] dark:text-[rgba(255,255,255,0.35)] hover:text-dark dark:hover:text-[rgba(255,255,255,0.9)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-1.96C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 1.96A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.4 19.54C5.12 20 12 20 12 20s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-1.96A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
            <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
          </svg>
        </a>
        <a href="https://x.com/TheBaldurion" target="_blank" rel="noopener noreferrer" aria-label="X (Twitter)" class="flex transition-colors duration-200 text-[rgba(0,0,0,0.4)] dark:text-[rgba(255,255,255,0.35)] hover:text-dark dark:hover:text-[rgba(255,255,255,0.9)]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.253 5.622 5.91-5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</footer>
