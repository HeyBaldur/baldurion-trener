---
import type { Locale } from '../i18n/index';
import { routeSlugs } from '../i18n/index';
interface Props {
  t: {
    heroTitle: string;
    heroSubtitle: string;
    photoAlt: string;
    body: {
      lead: string;
      paragraphs: string[];
    };
    cta: {
      eyebrow: string;
      title: string;
      subtitle: string;
      primaryAction: string;
      secondaryAction: string;
    };
  };
  locale: Locale;
}

const { t, locale } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const lp = locale === 'en' ? base : `${base}${locale}/`;
---

<div class="px-[24px] pt-[48px] pb-[96px] max-[640px]:px-[16px] max-[640px]:pt-[32px] max-[640px]:pb-[72px]">

  <section class="relative max-w-[1280px] mx-auto rounded-[24px] overflow-hidden min-h-[600px] bg-light border border-[rgba(0,0,0,0.06)] dark:bg-dark dark:border-[rgba(255,255,255,0.06)] max-[768px]:min-h-0">

    <div
      class="about-shape absolute top-0 right-0 bottom-0 w-[60%] z-[1] max-[768px]:top-auto max-[768px]:h-[50%] max-[768px]:w-full overflow-hidden"
      style="clip-path: polygon(35% 0, 100% 0, 100% 100%, 5% 100%);"
    >
      <img
        src={`${base}images/about/rudolf-cutout.png`}
        alt={t.photoAlt}
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <div class="relative z-[3] px-[64px] py-[96px] max-w-[50%] flex flex-col justify-center min-h-[600px] max-[768px]:max-w-full max-[768px]:px-[32px] max-[768px]:pt-[48px] max-[768px]:pb-[32px] max-[768px]:min-h-0 max-[640px]:px-[24px] max-[640px]:pt-[32px]">
      <h1
        class="font-display font-bold text-[clamp(2rem,5.5vw,4rem)] leading-[1.05] tracking-tight mt-0 mb-6 text-dark dark:text-light [&_.accent]:text-dark dark:[&_.accent]:text-lime"
        set:html={t.heroTitle}
      />
      <p class="font-body text-2xl leading-[1.6] max-w-[480px] m-0 text-[#555555] dark:text-[#CCCCCC]">
        {t.heroSubtitle}
      </p>
    </div>
  </section>

  <section class="max-w-[720px] mx-auto mt-[80px] px-[32px] max-[640px]:mt-[56px] max-[640px]:px-[16px]">
    <p
      class="font-display text-[clamp(22px,4vw,32px)] font-semibold leading-[1.15] pl-[20px] border-l-[3px] border-lime mt-0 mb-[28px] text-dark dark:text-white"
    >
      {t.body.lead}
    </p>
    <div class="flex flex-col gap-[14px]">
      {t.body.paragraphs.map((paragraph) => (
        <p
          class="font-body text-[18px] leading-[1.6] mt-0 mb-0 text-[#555555] dark:text-[#CCCCCC] [&_strong]:font-bold [&_strong]:text-dark dark:[&_strong]:text-lime max-[640px]:text-[17px]"
          set:html={paragraph}
        />
      ))}
    </div>
  </section>

  <section
    class="max-w-[1280px] mx-auto mt-[80px] p-[56px] rounded-[24px] flex justify-between items-center gap-[32px] max-[900px]:flex-col max-[900px]:items-stretch max-[900px]:p-[40px_32px] max-[900px]:mt-[56px] max-[640px]:p-[32px_24px]"
    style="background: linear-gradient(135deg, #D4E84A 0%, #C5D944 100%);"
  >
    <div>
      <div class="font-body text-[11px] font-extrabold tracking-[0.3em] uppercase mt-0 mb-[12px] text-dark">
        {t.cta.eyebrow.toUpperCase()}
      </div>
      <h2 class="font-display font-bold text-[clamp(1.5rem,3.5vw,2.5rem)] leading-[1.15] tracking-tight mt-0 mb-4 text-dark">
        {t.cta.title}
      </h2>
      <p class="font-body text-[16px] leading-[1.5] font-medium text-dark m-0 max-w-[540px]">
        {t.cta.subtitle}
      </p>
    </div>
    <div class="flex gap-[12px] shrink-0 max-[900px]:flex-col">
      <a
        href={`${lp}${routeSlugs.coaching[locale]}/`}
        class="font-body rounded-full bg-dark text-lime px-[32px] py-[18px] font-extrabold text-[13px] tracking-[0.05em] uppercase no-underline border-2 border-dark transition-[background,color] duration-200 whitespace-nowrap text-center hover:bg-transparent hover:text-dark"
      >
        {t.cta.primaryAction}
      </a>
      <a
        href={`${lp}${routeSlugs.contact[locale]}/`}
        class="font-body rounded-full bg-transparent text-dark px-[32px] py-[18px] font-bold text-[13px] tracking-[0.05em] uppercase no-underline border-2 border-dark transition-[background,color] duration-200 whitespace-nowrap text-center hover:bg-dark hover:text-lime"
      >
        {t.cta.secondaryAction}
      </a>
    </div>
  </section>

</div>

<style is:global>
  /* Hero shape: absolutely positioned next to the text on desktop, stacked
     above it on mobile. Both need clip-path, which Tailwind cannot express. */
  @media (max-width: 768px) {
    .about-shape {
      position: static !important;
      width: 100% !important;
      height: 300px !important;
      clip-path: polygon(0 0, 100% 0, 100% 88%, 0 100%) !important;
    }

    .about-shape img {
      object-position: top center;
    }
  }

  @media (max-width: 480px) {
    .about-shape {
      height: 240px !important;
    }
  }
</style>
